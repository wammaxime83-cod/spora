# Copie ce fichier en ".env" (ou définis ces variables chez ton hébergeur).
PORT=3000
NODE_ENV=production
# Adresse publique du site, SANS "/" final (ex. https://spora.cm)
SITE_URL=https://ton-domaine.com
# Base de données en production (gratuit sur turso.tech) :
# TURSO_DATABASE_URL=libsql://spora-xxxx.turso.io
# TURSO_AUTH_TOKEN=...
# Sans Turso : fichier local dans DATA_DIR (disque PERSISTANT requis).
DATA_DIR=./data
# Derrière Render / Railway / Nginx : 1
TRUST_PROXY=1
# E-mails (séparés par des virgules) qui deviennent administrateurs à l'inscription
ADMIN_EMAILS=toi@exemple.com
# Envoi d'e-mails (confirmation, mot de passe oublié). Sans SMTP, les e-mails s'affichent dans les logs.
# SMTP_URL=smtps://utilisateur:motdepasse@smtp.exemple.com:465
# MAIL_FROM=Spora <no-reply@ton-domaine.com>

# Vidéos : sans cette ligne = mode test (stockage sur le serveur, 30 Mo). Avec Cloudinary (gratuit) :
# CLOUDINARY_URL=cloudinary://clé:secret@nom_du_cloud
# MAX_VIDEOS=3
